// Prisma Schema for World Sim
// Based on ERD v0.2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum Direction {
  INDUSTRY
  FINANCE
  MILITARY
  TECH
}

enum Difficulty {
  EASY
  NORMAL
  HARD
  EXTREME
}

enum UGCStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
  BANNED
}

enum PolicyCategory {
  ECONOMY
  WELFARE
  TECH
  MILITARY
  DIPLOMACY
  RISK
}

enum EventCategory {
  ECONOMY
  MILITARY
  TECH
  SOCIAL
  DIPLOMACY
}

enum LeaderboardType {
  DAILY
  WEEKLY
  SEASON
  CATEGORY
}

enum ReportReason {
  HATE
  POLITICS
  VIOLENCE
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ModerationActionType {
  WARN
  HIDE
  BAN
  RESTORE
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  nickname      String?
  avatarUrl     String?
  provider      String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  gameSessions      GameSession[]
  challenges        Challenge[]
  policyDecks       PolicyDeck[]
  mapSeeds          MapSeed[]
  reports           UGCReport[]        @relation("Reporter")
  moderationActions ModerationAction[] @relation("Admin")

  // NextAuth
  accounts Account[]
  sessions Session[]
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== GAME CORE ====================

model Season {
  id           String       @id @default(cuid())
  name         String       // e.g., "S1", "S2"
  number       Int          @unique
  startDate    DateTime
  endDate      DateTime
  status       SeasonStatus @default(UPCOMING)
  scoreWeights Json?        // Score calculation weights
  specialRules Json?        // Season-specific rules

  // Relations
  gameSessions         GameSession[]
  leaderboardSnapshots LeaderboardSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NationTemplate {
  id           String @id // e.g., "balanced", "industrial"
  name         String
  displayName  String // e.g., "Team Korea"
  flagUrl      String?
  initialStats Json   // Initial stats JSON

  // Relations
  gameSessions GameSession[]
}

model GameSession {
  id               String        @id @default(cuid())
  userId           String
  seasonId         String
  nationTemplateId String
  challengeId      String?
  mapSeedId        String?
  direction        Direction
  currentStats     Json          // Current stats (9 stats)
  currentTurn      Int           @default(1)
  totalScore       Int           @default(0)
  status           SessionStatus @default(ACTIVE)

  // Relations
  user           User            @relation(fields: [userId], references: [id])
  season         Season          @relation(fields: [seasonId], references: [id])
  nationTemplate NationTemplate  @relation(fields: [nationTemplateId], references: [id])
  challenge      Challenge?      @relation(fields: [challengeId], references: [id])
  mapSeed        MapSeed?        @relation(fields: [mapSeedId], references: [id])
  turnDecisions  TurnDecision[]
  turnSnapshots  TurnSnapshot[]
  eventInstances EventInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([seasonId])
  @@index([status])
}

model TurnDecision {
  id               String   @id @default(cuid())
  sessionId        String
  turnNumber       Int
  budget           Json     // { economy, welfare, research, military, diplomacy }
  activePolicies   Json     // Array of policy IDs
  diplomacyActions Json?    // Array of diplomacy actions
  submittedAt      DateTime @default(now())

  // Relations
  session GameSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, turnNumber])
  @@index([sessionId])
}

model TurnSnapshot {
  id            String   @id @default(cuid())
  sessionId     String
  turnNumber    Int
  statsSnapshot Json     // Stats after settlement
  scoreChange   Int      @default(0)
  totalScore    Int      @default(0)
  processedAt   DateTime @default(now())

  // Relations
  session        GameSession     @relation(fields: [sessionId], references: [id])
  eventInstances EventInstance[]

  @@unique([sessionId, turnNumber])
  @@index([sessionId])
}

// ==================== EVENTS ====================

model EventDefinition {
  id       String        @id // e.g., "financial-crisis"
  name     String
  category EventCategory
  triggers Json          // Trigger conditions
  effects  Json          // Stat effects
  duration Int           @default(0) // 0 = instant
  isActive Boolean       @default(true)

  // Relations
  eventInstances EventInstance[]
}

model EventInstance {
  id                String @id @default(cuid())
  definitionId      String
  snapshotId        String
  sessionId         String
  turnNumber        Int
  appliedEffects    Json   // Effects that were applied
  remainingDuration Int    @default(0)

  // Relations
  definition EventDefinition @relation(fields: [definitionId], references: [id])
  snapshot   TurnSnapshot    @relation(fields: [snapshotId], references: [id])
  session    GameSession     @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([definitionId])
}

// ==================== UGC: CHALLENGES ====================

model Challenge {
  id                  String     @id @default(cuid())
  creatorId           String
  title               String
  description         String?
  seasonScope         String?
  seed                Int        @default(0)
  startNationTemplate String     @default("balanced")
  constraints         Json       // Array of constraints
  winConditions       Json       // Array of win conditions
  turnLimit           Int        @default(30)
  difficulty          Difficulty @default(NORMAL)
  status              UGCStatus  @default(DRAFT)
  playCount           Int        @default(0)
  completionCount     Int        @default(0)
  likeCount           Int        @default(0)
  reportCount         Int        @default(0)
  isOfficial          Boolean    @default(false)
  publishedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  creator      User          @relation(fields: [creatorId], references: [id])
  gameSessions GameSession[]

  @@index([status])
  @@index([creatorId])
  @@index([isOfficial])
  @@index([publishedAt])
}

// ==================== UGC: POLICY DECKS ====================

model PolicyCard {
  id          String         @id // e.g., "export-boost"
  name        String
  category    PolicyCategory
  description String
  effects     Json           // Stat effects
  conditions  Json?          // Application conditions
  isActive    Boolean        @default(true)

  // Relations
  deckCards PolicyDeckCard[]
}

model PolicyDeck {
  id          String    @id @default(cuid())
  creatorId   String
  name        String
  description String?
  playstyle   String?   // e.g., "aggressive", "balanced"
  status      UGCStatus @default(DRAFT)
  copyCount   Int       @default(0)
  likeCount   Int       @default(0)
  reportCount Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  creator   User             @relation(fields: [creatorId], references: [id])
  deckCards PolicyDeckCard[]

  @@index([status])
  @@index([creatorId])
}

model PolicyDeckCard {
  id       String @id @default(cuid())
  deckId   String
  cardId   String
  priority Int    // 1-8

  // Relations
  deck PolicyDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card PolicyCard @relation(fields: [cardId], references: [id])

  @@unique([deckId, cardId])
}

// ==================== UGC: MAP SEEDS ====================

model MapSeed {
  id               String    @id @default(cuid())
  creatorId        String
  name             String
  seed             Int
  resourceRichness String    @default("NORMAL") // SCARCE, NORMAL, ABUNDANT
  oilBias          Float     @default(0.5)
  mineralBias      Float     @default(0.5)
  tradeAccess      String    @default("NORMAL") // LOW, NORMAL, HIGH
  disasterRate     String    @default("NORMAL") // LOW, NORMAL, HIGH
  status           UGCStatus @default(DRAFT)
  playCount        Int       @default(0)
  reportCount      Int       @default(0)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  creator      User          @relation(fields: [creatorId], references: [id])
  gameSessions GameSession[]

  @@index([status])
  @@index([creatorId])
}

// ==================== LEADERBOARD ====================

model LeaderboardSnapshot {
  id           String          @id @default(cuid())
  seasonId     String
  snapshotDate DateTime
  type         LeaderboardType @default(DAILY)
  category     String?         // ALL, ECONOMY, TECH, DIPLOMACY
  rankings     Json            // Array of rankings
  totalPlayers Int             @default(0)
  createdAt    DateTime        @default(now())

  // Relations
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, snapshotDate, type, category])
  @@index([seasonId, snapshotDate])
}

// ==================== MODERATION ====================

model UGCReport {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String       // CHALLENGE, POLICY_DECK, MAP_SEED
  targetId    String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  // Relations
  reporter User              @relation("Reporter", fields: [reporterId], references: [id])
  actions  ModerationAction[]

  @@index([status])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String               @id @default(cuid())
  reportId   String?
  adminId    String
  targetType String
  targetId   String
  action     ModerationActionType
  reason     String?
  createdAt  DateTime             @default(now())

  // Relations
  report UGCReport? @relation(fields: [reportId], references: [id])
  admin  User       @relation("Admin", fields: [adminId], references: [id])
}
